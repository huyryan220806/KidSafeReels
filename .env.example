# Documentation only. Set these in your shell; no dotenv loader is installed.
KIDSAFE_BACKEND=mock
KIDSAFE_API_URL=http://127.0.0.1:8000
# Optional absolute artifact directory; default is models/checkpoints in the repo.
# KIDSAFE_MODEL_DIR=D:\path\to\models\checkpoints
KIDSAFE_MEDIA_TIMEOUT=30
KIDSAFE_MODEL_TIMEOUT=180
# Keep HTTP timeout above media + model timeout, allowing transfer overhead.
KIDSAFE_HTTP_TIMEOUT=225
